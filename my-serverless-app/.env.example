# ==============================================================================
# The Serverless Odyssey - Public Environment Variables Template
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud (PostgreSQL & Storage)
# https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
# Public Project URL (safe for client-side consumption)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon/Publishable Key (respects Row Level Security / RLS policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (BYPASSES RLS - Server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Cloudinary CDN (Media Storage & Transformations)
# https://cloudinary.com/console
# ------------------------------------------------------------------------------
# Cloudinary Cloud Name (safe for client-side uploads/display)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Cloudinary API Key (Server-side / Edge runtime)
CLOUDINARY_API_KEY=your-cloudinary-api-key

# Cloudinary API Secret (Keep private - Server-side only)
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Cloudinary Upload Preset (Unsigned or signed upload preset identifier)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-cloudinary-upload-preset

# ------------------------------------------------------------------------------
# 3. Application & Deployment Config
# ------------------------------------------------------------------------------
# Base URL for metadata, auth redirects, and absolute links
NEXT_PUBLIC_APP_URL=http://localhost:3000
